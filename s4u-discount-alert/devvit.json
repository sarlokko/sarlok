{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "s4u-discount-alert",
  "server": {},
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "user"
    },
    "redis": true
  },
  "scheduler": {
    "tasks": {
      "check-s4u-discounts": {
        "endpoint": "/internal/scheduler/check-s4u-discounts",
        "cron": "17 * * * *"
      }
    }
  },
  "settings": {
    "global": {
      "reddit_recipient": {
        "type": "string",
        "label": "Reddit alert recipient",
        "helpText": "Reddit username that receives qualifying S4U discount alerts.",
        "defaultValue": "sarlokkko"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Check S4U discounts now",
        "description": "Run the read-only S4U discount monitor immediately.",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/check-s4u-discounts"
      },
      {
        "label": "Send notification test",
        "description": "Send a test private message to the configured Reddit account.",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/send-notification-test"
      }
    ]
  },
  "scripts": {
    "dev": "npm run watch"
  },
  "dev": {
    "subreddit": "s4u_discount_aler_dev"
  }
}
